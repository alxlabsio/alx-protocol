# ALX Protocol — environment configuration
# Copy to .env and fill in your values. Never commit .env.
#
# The CLI reads these automatically. You can also pass most values
# as flags (e.g. --rpc-url, --endpoint, --api-key) which take precedence.

# ── IPFS ──────────────────────────────────────────────────────────────────────
# Local Kubo node (default). Used by: alx publish --ipfs, alx block create --from-ipfs
ALX_IPFS_ENDPOINT=http://localhost:5001
# Public gateway for resolving CIDs during alx resolve
ALX_IPFS_GATEWAY=https://ipfs.io/ipfs

# ── S3-compatible object storage ──────────────────────────────────────────────
# Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, and any S3-compatible API.
# Used by: alx block create --from-s3
ALX_S3_BUCKET=
ALX_S3_REGION=us-east-1
ALX_S3_ACCESS_KEY_ID=
ALX_S3_SECRET_ACCESS_KEY=
# Leave blank for AWS. Set for R2 (https://<account>.r2.cloudflarestorage.com),
# MinIO (http://localhost:9000), or any custom endpoint.
ALX_S3_ENDPOINT=

# ── ALX Retrieval server ───────────────────────────────────────────────────────
# Shared team Block store. Used by: alx publish --endpoint, alx resolve --endpoint
ALX_RETRIEVAL_ENDPOINT=http://localhost:8081
ALX_RETRIEVAL_API_KEY=

# ── Base / EVM (on-chain anchoring) ───────────────────────────────────────────
# Used by: alx anchor, alx anchor-query
ALX_RPC_URL=https://mainnet.base.org
# WARNING: never commit a funded private key. Use a dedicated signing wallet.
ALX_PRIVATE_KEY=

# ── General ───────────────────────────────────────────────────────────────────
# Override default HTTP fetch timeout (ms) for --from-url and --from-ipfs
ALX_FETCH_TIMEOUT_MS=10000
