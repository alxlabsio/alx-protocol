    "content": {
      "definitionLevel": "indexed",
      "contentType": "security.review.decision",
      "schemaVersion": "1.0",
      "index": {
        "title": "Conditional approval for analytics vendor integration",
        "domain": "security",
        "contentType": "security.review.decision",
        "concepts": [
          "vendor-risk",
          "conditional-approval",
          "least-privilege",
          "mfa",
          "retention"
        ],
        "entities": [
          "Northlake Analytics"
        ],
        "status": "conditions-required"
      },
      "data": {
        "decisionId": "sec-review-2026-001",
        "summary": "Northlake Analytics connector is approved for limited production use after retention, MFA, and least-privilege conditions are satisfied.",
        "subject": {
          "vendor": "Northlake Analytics",
          "integration": "analytics connector",
          "requestedAccess": [
            "support-ticket metadata",
            "usage telemetry"
          ],
          "approvedAccess": [
            "support-ticket metadata"
          ],
          "accessLimitations": [
            "read-only access",
            "no credential access",
            "no payment data access",
            "no raw message content access"
          ]
        },
        "decision": {
          "outcome": "approve-with-conditions",
          "status": "conditions-required",
          "effectiveDate": "2026-05-18",
          "decisionOwner": "security-architecture",
          "nextReviewTrigger": "before-production-release"
        },
        "rationale": {
          "summary": "The integration can operate within the baseline if access is narrowed, retention is reduced, and vendor admin MFA is enforced.",
          "basis": [
            {
              "artifactRole": "vendor-security-questionnaire",
              "usedFor": [
                "requested data scope",
                "vendor access model",
                "available security controls"
              ]
            },
            {
              "artifactRole": "third-party-data-handling-baseline",
              "usedFor": [
                "retention limit",
                "MFA requirement",
                "least-privilege requirement"
              ]
            }
          ]
        },
        "conditions": [
          {
            "id": "condition-001",
            "requirement": "Reduce vendor retention for approved data to 90 days.",
            "control": "retention",
            "status": "required-before-production",
            "owner": "vendor-security",
            "evidenceRequired": "retention configuration export"
          },
          {
            "id": "condition-002",
            "requirement": "Enable MFA for all vendor admin accounts.",
            "control": "mfa",
            "status": "required-before-production",
            "owner": "identity-security",
            "evidenceRequired": "admin MFA configuration evidence"
          },
          {
            "id": "condition-003",
            "requirement": "Limit integration permissions to approved telemetry fields.",
            "control": "least-privilege",
            "status": "required-before-production",
            "owner": "application-security",
            "evidenceRequired": "permission review export"
          }
        ],
        "risks": [
          {
            "id": "risk-001",
            "risk": "Vendor retains limited operational access to approved telemetry fields.",
            "severity": "medium",
            "status": "accepted-with-monitoring",
            "mitigation": "Restrict fields, enforce retention, and monitor access logs during the first production cycle."
          },
          {
            "id": "risk-002",
            "risk": "Vendor admin compromise could expose approved telemetry fields.",
            "severity": "medium",
            "status": "mitigated-by-condition",
            "mitigation": "Require MFA before production access."
          }
        ],
        "actions": [
          {
            "id": "action-001",
            "type": "collect-evidence",
            "description": "Collect retention configuration export from vendor.",
            "owner": "vendor-security",
            "requiredBefore": "production-release",
            "status": "open"
          },
          {
            "id": "action-002",
            "type": "verify-control",
            "description": "Verify MFA enforcement for all vendor admin accounts.",
            "owner": "identity-security",
            "requiredBefore": "production-release",
            "status": "open"
          },
          {
            "id": "action-003",
            "type": "review-permissions",
            "description": "Confirm permissions are limited to approved fields.",
            "owner": "application-security",
            "requiredBefore": "production-release",
            "status": "open"
          }
        ]
      }
    }
  },
