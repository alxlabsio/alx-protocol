{
  "$schema": "../schemas/test-vector.schema.json",
  "suite": "block-identity",
  "description": "Block creation and identity derivation vectors",
  "vectors": [
    {
      "id": "B1",
      "description": "empty block (null content, no parents)",
      "inputShape": "single",
      "input": {
        "content": null,
        "parentHashes": []
      },
      "expected": {
        "canonicalEnvelopeHex": "7b22636f6e74656e74223a6e756c6c2c22706172656e74486173686573223a5b5d7d",
        "blockHash": "0x44e064968108cf3f2b0b2b480ceeb78d2ff4b7ca443481a0c88a18461cc5dbae",
        "contentHash": "0xefbde2c3aee204a69b7696d4b10ff31137fe78e3946306284f806e2dfc68b805",
        "parentHashes": []
      },
      "assertions": [
        "blockHash == deriveBlockHash(null, [])",
        "contentHash == deriveContentHash(null)",
        "parentHashes == []",
        "content == null",
        "blockHash != contentHash"
      ]
    },
    {
