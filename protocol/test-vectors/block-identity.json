          "a": 2,
          "z": 1
        },
        "parentHashes": []
      },
      "expected_a": {
        "canonicalEnvelopeHex": "7b22636f6e74656e74223a7b2261223a322c227a223a317d2c22706172656e74486173686573223a5b5d7d",
        "blockHash": "0x476f4adb62b1f76cd98a25fc02319fe8f7778be3f9c113e17493e3c879effd7e",
        "contentHash": "0xdae6267db5994da55c63d71c49e689bcf1eec0e360f1c0c45a4cd1b6785968b9",
