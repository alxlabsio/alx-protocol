      "description": "simple string content",
      "inputShape": "single",
      "input": {
        "content": "hello",
        "parentHashes": []
      },
      "expected": {
        "canonicalEnvelopeHex": "7b22636f6e74656e74223a2268656c6c6f222c22706172656e74486173686573223a5b5d7d",
        "blockHash": "0x744ec2ec3ead89af23488392ddd388a4608dd332fdf0ca24c2fc7dc9f4e6678c",
        "contentHash": "0xf6fb31fdcaf3bd3f8350b3591a8d548dd83b099e7a76446b1fdda2f5ebdd1232",
        "parentHashes": []
      },
      "assertions": [
        "blockHash == deriveBlockHash(\"hello\", [])"
      ]
    },
