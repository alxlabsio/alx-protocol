{
  "configVersion": "1.0.0",
  "protocolVersion": "1",
  "profile": "minimal-chain",
  "networks": {
    "base-mainnet": {
      "chainId": 8453,
      "rpcUrl": "https://mainnet.base.org",
      "rpcUrlEnv": "ALX_BASE_RPC_URL",
      "explorerUrl": "https://basescan.org"
    },
    "base-sepolia": {
      "chainId": 84532,
      "rpcUrlEnv": "ALX_BASE_SEPOLIA_RPC_URL",
      "explorerUrl": "https://sepolia.basescan.org"
    }
  },
  "components": {
    "blocks": {
      "type": "protocol",
      "lifecycle": "active"
    },
    "ipfs": {
      "type": "storage",
      "lifecycle": "active"
    }
  },
  "contracts": {
    "anchor": {
      "contractName": "ALXAnchor",
      "lifecycle": "planned",
      "abi": "contracts/abis/ALXAnchor.json",
      "defaultNetwork": "base-sepolia",
      "deployments": {
        "base-sepolia": {
          "state": "planned",
          "address": null,
          "addressEnv": "ALX_ANCHOR_ADDRESS_BASE_SEPOLIA"
        },
        "base-mainnet": {
          "state": "planned",
          "address": null,
          "addressEnv": "ALX_ANCHOR_ADDRESS_BASE_MAINNET"
        }
      },
      "capabilities": [
        "anchor-block-hash",
        "anchor-batch"
      ],
      "writePolicy": "optional"
    }
  },
  "defaults": {
    "artifactPath": [
      "blocks",
      "ipfs"
    ],
    "onChainWrites": "none"
  },
  "optionalOperations": {
    "anchor": {
      "contract": "anchor",
      "frequency": "rare"
    }
  }
}
