      "path": "protocol/extensions/signing/test-vectors/ed25519-attestations.json"
    },
    {
      "id": "alx.signing.p256.v1",
      "path": "protocol/extensions/signing/test-vectors/p256-attestations.json"
    }
  ],
  "runner": {
    "type": "cli",
    "command": "alx",
    "args": ["extension-conformance", "signing"]
  },
  "schemas": [
    {
      "id": "signed-block",
      "path": "protocol/extensions/signing/schemas/signed-block.schema.json"
    }
  ],
  "errorCodes": "protocol/extensions/signing/error-codes.json"
