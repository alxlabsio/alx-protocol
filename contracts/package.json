{
  "name": "@alx-protocol/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "ALXAnchor — existence-time registry for ALX Protocol Blocks on Base. Deployment artifact only — not an npm package.",
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "lint": "solhint \"src/**/*.sol\" --max-warnings 0",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network base-sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network base-mainnet",
    "verify:sepolia": "hardhat verify --network base-sepolia",
    "verify:mainnet": "hardhat verify --network base-mainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "hardhat": "2.29.0",
    "hardhat-gas-reporter": "2.3.0",
    "solhint": "6.2.3"
  }
}
