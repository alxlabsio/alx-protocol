{
  "name": "@alx-protocol/adapters",
  "private": true,
  "version": "1.0.0",
  "description": "Optional application adapters for storing ALX Protocol Blocks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./browser": { "import": "./dist/browser.js", "types": "./dist/browser.d.ts" },
    "./file": { "import": "./dist/file.js", "types": "./dist/file.d.ts" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test ../tests/integration/adapters"
  },
  "dependencies": { "@alx-protocol/sdk": "workspace:*" },
  "devDependencies": { "@types/node": "^25.6.0", "typescript": "^5.4.0" },
  "engines": { "node": ">=20 <23" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xandrlabs/alx-protocol",
    "directory": "adapters"
  }
}
